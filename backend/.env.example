# ============ Timedoor FAQ Bot - Backend ============
# CATATAN: parser .env ini TIDAK mendukung komentar di baris yang sama
# dengan nilai. Tulis komentar di baris sendiri (lihat contoh di bawah).

# WAJIB: API key Gemini (dipakai untuk embedding + generate jawaban).
GEMINI_API_KEY=isi_api_key_kamu

# Model penjawab di chat (opsional; default gemini-flash-latest di kode).
GEMINI_MODEL=gemini-3.5-flash

# --- Embedding ---
RAG_EMBED_MODEL=gemini-embedding-001
# Pilihan dimensi: 3072 | 1536 | 768
RAG_EMBED_DIM=768

# --- Chunking (dipakai saat membangun indeks / meng-embed dokumen) ---
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=120

# --- Penyimpanan vektor ---
# Pilihan: postgres | jsonl
RAG_STORE_BACKEND=postgres
# Port host mengikuti docker-compose (5433). Ubah kalau beda.
RAG_PG_DSN=postgresql://faqbot:faqbot@localhost:5433/faqbot
RAG_PG_TABLE=faq_kb

# Origin frontend yang boleh akses API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:5173

# --- Opsional ---
# Lokasi dokumen KB (.md). Default: folder data/ di backend.
# RAG_DOCS_DIR=./data
# Lokasi indeks lokal (hanya dipakai kalau RAG_STORE_BACKEND=jsonl).
# RAG_INDEX_DIR=./index_cache
# Jumlah chunk konteks yang diambil saat menjawab (default 5).
# RAG_TOP_K=5
# 1 = embedding tiruan; uji pipeline tanpa API/kuota.
# RAG_MOCK_EMBED=0
# Jeda antar dokumen saat build index (detik).
# RAG_SLEEP_BETWEEN_DOCS=1.0
